{
  "name": "pulso-saga",
  "version": "0.1.0",
  "description": "Orchestrated saga for the Pulso order flow with outbox, idempotent consumers, retries, DLQ, circuit breaker, rate limiter and bulkhead.",
  "license": "MIT",
  "author": "Alejandro Álvarez",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate.ts",
    "start:orchestrator": "node dist/apps/orchestrator.js",
    "start:services": "node dist/apps/fake-services.js"
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
